<bs:modalDialog formId="${idNewTokenForm}"
                title="Generate new token"
                saveCommand="BS.NewTokenDialog.proceed(); return false;"
                closeCommand="BS.NewTokenDialog.cancel(); return false;"
                action="#">
  <%@include file="_newTokenForm.jspf" %>
  <div id="${idNewtokenDialogButtons}" class="popupSaveButtonsBlock">
    <forms:submit onclick="BS.NewTokenDialog.proceed(); return false" label="Save" id="${idTokenDialogSaveButton}"/>
    <forms:cancel onclick="BS.NewTokenDialog.cancel(); return false" id="${idTokenDialogCancelButton}"/>
    <forms:saving id="${idTokenDialogWaiter}" style="float: none;"/>
  </div>
</bs:modalDialog>

<script type="text/javascript">
  BS.NewTokenDialog = OO.extend(BS.AbstractModalDialog, {
    _popupWindow: undefined,

    getContainer() {
      return $('${idNewTokenFormDialog}')
    },

    formElement() {
      return $('${idNewTokenForm}');
    },

    proceed() {
      this.disableButtons();
      this.startWaiting();
      BS.NewTokenForm.hideGenericError();
      BS.NewTokenForm.disable();

      let manuallyClosed = true;

      BS.NewTokenForm.validate().then(() => {
        const formValues = BS.NewTokenForm.getValues();
        return new Promise((resolve, reject) => {
          this._popupWindow = BS.Util.popupWindow('', '_blank', {safe: false});
          this._popupWindow.document.write('Loading...');

          BS.TokenObtainer.tokenFromConnection(null,
            '${project.externalId}',
            formValues.connection.id,
            {
              getTokenPage: formValues.connection.provider.tokenPopupPath,
              callback: (tokenInfo) => {
                if (this._popupWindow.closed) {
                  // we're probably already rejected, this is the fallback logic
                  this.acceptToken(tokenInfo);
                }

                resolve(tokenInfo);
              },
              errorCallback: (error) => reject(error),
              useAlertService: BS.TokenControlParams.useAlertService,
              tokenIntentType: formValues.tokenIntentType,
              projectScope: formValues.projectScope,
              accessibleEntities: formValues.accessibleEntities,
              tokenName: formValues.tokenName,
              requestNewToken: true,
              popupWindow: this._popupWindow
            }
          );

          const closeTimer = setInterval(() => {
            if (this._popupWindow && this._popupWindow.closed) {
              clearInterval(closeTimer);
              if (manuallyClosed) {
                reject(new Error("popup was manually closed"));
              }
            }
          }, 1000);
        });
      }).then((tokenInfo) => {
        this.acceptToken(tokenInfo);
      }).catch((error) => {
        console.debug("ignored error", error);
      }).finally(() => {
        manuallyClosed = false;
        this.abort();
      });
    },

    acceptToken(tokenInfo) {
      BS.TokenControlParams.tokenCallback(tokenInfo);
      if (BS.TokenControls.isEmbedMode()) {
        this.closeEmbedded();
      } else {
        this.close();
      }
    },

    abort() {
      this.stopWaiting();
      BS.NewTokenForm.enable();
      this.enableButtons();
      if (this._popupWindow) {
        this._popupWindow.close();
      }
    },

    abortWithError(errorMessage) {
      BS.NewTokenForm.showGenericError(errorMessage);
      this.abort();
    },

    closeEmbedded() {
      BS.NewTokenForm.hideEmbedded();
      BS.TokenControls.showGenerateButtons();
      BS.TokenControls.showActionButtons();
    },

    cancel() {
      if (BS.TokenControls.isEmbedMode()) {
        this.closeEmbedded();
      } else {
        this.close();
      }
    },

    show() {
      BS.NewTokenForm.init();
      this.enableButtons();
      this.stopWaiting();
      this.setSubmitButtonCaption(BS.TokenControlParams.acquireCaption);

      if (BS.TokenControls.isEmbedMode()) {
        BS.TokenControls.hideActionButtons();
        BS.TokenControls.hideGenerateButtons();
        BS.NewTokenForm.showEmbedded();
        BS.NewTokenForm.focusInput();
        this.injectDialogButtonsIntoEmbed();
      } else {
        this.showCentered().then(() => {
          BS.NewTokenForm.focusInput();
        });
      }
    },

    injectDialogButtonsIntoEmbed() {
      $j('#${idNewtokenDialogButtons}').removeClass('popupSaveButtonsBlock').appendTo($j('#${idEmbeddedButtonCell}'));
    },

    disableButtons() {
      $('${idTokenDialogSaveButton}').disabled = true;
      $j('#${idTokenDialogCancelButton}').attr('disabled', 'disabled').addClass('disable-click');
    },

    enableButtons() {
      $('${idTokenDialogSaveButton}').disabled = false;
      $j('#${idTokenDialogCancelButton}').removeAttr('disabled').removeClass('disable-click');
    },

    startWaiting() {
      $('${idTokenDialogWaiter}').show();
    },

    stopWaiting() {
      $('${idTokenDialogWaiter}').hide();
    },

    setSubmitButtonCaption(caption) {
      $('${idTokenDialogSaveButton}').value = caption ? caption : 'Save';
    },

    hide() {
      BS.NewTokenForm.hide();
    }
  });
</script>